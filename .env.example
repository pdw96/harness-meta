# harness-meta — environment variables
# Copy to .env (gitignored) or set in your shell rc file.
# At the meta-repo level, only HARNESS_META_ROOT is consumed.
# Per-project runtime variables live in each project's docs/HARNESS.md.

# Override the harness-meta clone location.
# Referenced by: claude/hooks/session-init.sh, claude/statusline/statusline.sh,
# component-installer subagent (v4.0+ B3 — install.ps1 폐기), all tests/smoke-*.sh.
# Default: $HOME/harness-meta
HARNESS_META_ROOT=
